APP_NAME=Sumon
NODE_ENV=production

NEXT_PUBLIC_APP_URL=https://www.example.com
API_BASE_URL=https://api.example.com/api
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/auth
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_CSRF_COOKIE_URL=https://api.example.com/sanctum/csrf-cookie
AUTH_PROXY_API_BASE_URL=https://api.example.com/api/auth
ALLOW_MISSING_PUBLIC_API=false

# Set these during the build and keep the same value on every Next.js instance.
DEPLOYMENT_VERSION=replace-with-git-sha
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

NEXT_PUBLIC_REVERB_APP_KEY=replace-with-reverb-app-key
NEXT_PUBLIC_REVERB_HOST=ws.example.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
